{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Account Service",
      "type": "shell",
      "command": "cd services/account-service ; npm run dev",
      "problemMatcher": []
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "cd frontend/web ; npm run dev",
      "problemMatcher": []
    },
    {
      "label": "Start App",
      "dependsOn": ["Start Account Service", "Start Frontend"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Install All Dependencies",
      "type": "shell",
      "command": "npm install --prefix services/account-service ; npm install --prefix frontend/web",
      "problemMatcher": []
    }
  ]
}
